MAINICON ICON DISCARDABLE "uget-icon.ico"

// Tray icon states, mirroring the uget-tray-* icon names used on Unix.
// Embedded as resources so the tray has no runtime file dependency.
TRAYDEFAULT     ICON DISCARDABLE "uget-tray-default.ico"
TRAYDOWNLOADING ICON DISCARDABLE "uget-tray-downloading.ico"
TRAYERROR       ICON DISCARDABLE "uget-tray-error.ico"

1 VERSIONINFO
FILEVERSION     @VER_COMMA@
PRODUCTVERSION  @VER_COMMA@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "uget.ugetdm.com"
      VALUE "FileDescription", "uGet download manager"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "uGet"
      VALUE "LegalCopyright", "Copyright (C) 2005-2020 by C.H. Huang, 2026 by Ozgur As"
      VALUE "OriginalFilename", "uget.exe"
      VALUE "ProductName", "uGet"
      VALUE "ProductVersion", "@VERSION@"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
