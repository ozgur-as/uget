msgid "Unable to create thread."
msgstr "Не выйшла стварыць трэд."

#. UGET_EVENT_ERROR_THREAD_CREATE_FAILED,
#: uget/UgetEvent.c:86
msgid "Incorrect source (different file size)."
msgstr "Памылковая крыніца (адрозны памер файла)."

