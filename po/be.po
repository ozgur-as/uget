msgid "cookie file not found."
msgstr "Файл cookie не знойдзены."

#. 1 - 10
#: uget/UgetPluginAria2.c:278
msgid "aria2: an unknown error occurred."
msgstr "aria2: адбылася невядомая памылка."

#: uget/UgetPluginAria2.c:279
msgid "aria2: time out occurred."
msgstr "aria2: адбылося заканчэнне чакання."

#: uget/UgetPluginAria2.c:280
msgid "aria2: resource was not found."
msgstr "aria2: рэсурс не знойдзены."

#: uget/UgetPluginAria2.c:281
msgid ""
"aria2 saw the specified number of 'resource not found' error. See --max-file-"
"not-found option"
msgstr "aria2 сутыкнулася з зададзенай колькасцю памылак «рэсурс не знойдзены». Гл. опцыю --max-file-not-found"

#: uget/UgetPluginAria2.c:282
msgid "aria2: speed was too slow."
msgstr "aria2: хуткасць была занадта нізкай."

#: uget/UgetPluginAria2.c:283
msgid "aria2: network problem occurred."
msgstr "aria2: узнікла праблема з сеткай."

#: uget/UgetPluginAria2.c:284
msgid "aria2: unfinished downloads."
msgstr "aria2: незавершаныя спампоўкі."

#. _("Not Resumable"),
#: uget/UgetPluginAria2.c:286
msgid "Out of resource"
msgstr "Няма рэсурсаў"

#. _(),
#: uget/UgetPluginAria2.c:287
msgid "aria2: piece length was different from one in .aria2 control file."
msgstr "aria2: даўжыня часткі адрознівалася ад той, што ў кантрольным файле .aria2."

#. 11 - 20
#: uget/UgetPluginAria2.c:289
msgid "aria2 was downloading same file."
msgstr "aria2 спампоўваў той жа файл."

#: uget/UgetPluginAria2.c:290
msgid "aria2 was downloading same info hash torrent."
msgstr "aria2 спампоўваў торэнт з такім жа інфармацыйным хэшам."

#: uget/UgetPluginAria2.c:291
msgid "aria2: file already existed. See --allow-overwrite option."
msgstr "aria2: файл ужо існаваў. Гл. опцыю --allow-overwrite."

#. _("Output file can't be renamed."),
#: uget/UgetPluginAria2.c:293
msgid "aria2: could not open existing file."
msgstr "aria2: не ўдалося адкрыць існуючы файл."

#: uget/UgetPluginAria2.c:294
msgid "aria2: could not create new file or truncate existing file."
msgstr "aria2: не ўдалося стварыць новы файл або скараціць існуючы файл."

#: uget/UgetPluginAria2.c:295
msgid "aria2: file I/O error occurred."
msgstr "aria2: адбылася памылка ўводу-вываду файла."

#. UGET_EVENT_ERROR_FOLDER_CREATE_FAILED
#: uget/UgetPluginAria2.c:297
msgid "aria2: name resolution failed."
msgstr "aria2: рашэнне імёнаў правалена."

#: uget/UgetPluginAria2.c:298
msgid "aria2: could not parse Metalink document."
msgstr "aria2: не ўдалося парсіраваць дакумент Metalink."

#. 21 - 30
#: uget/UgetPluginAria2.c:300
msgid "aria2: FTP command failed."
msgstr "aria2: FTP-каманда не ўдалася."

#: uget/UgetPluginAria2.c:301
msgid "aria2: HTTP response header was bad or unexpected."
msgstr "aria2: Загаловак HTTP-адказу быў няправільны або нечаканы."

#: uget/UgetPluginAria2.c:302
msgid "Too many redirections."
msgstr "Занадта шмат перанакіраванняў."

#: uget/UgetPluginAria2.c:303
msgid "aria2: HTTP authorization failed."
msgstr "aria2: Аўтэнтыфікацыя HTTP правалілася."

#: uget/UgetPluginAria2.c:304
msgid "aria2: could not parse bencoded file(usually .torrent file)."
msgstr "aria2: не ўдалося парсіраваць bencoded-файл (звычайна файл .torrent)."

#: uget/UgetPluginAria2.c:305
msgid "aria2: torrent file was corrupted or missing information."
msgstr "aria2: торэнт-файл быў пашкоджаны або адсутнічае інфармацыя."

#: uget/UgetPluginAria2.c:306
msgid "aria2: Magnet URI was bad."
msgstr "aria2: Магнітны URI быў няправільны."

#: uget/UgetPluginAria2.c:307
msgid ""
"aria2: bad/unrecognized option was given or unexpected option argument was "
"given."
msgstr "aria2: пададзены няправільны/непрызнаны параметр або нечаканы аргумент параметра."

#: uget/UgetPluginAria2.c:308
msgid "aria2: remote server was unable to handle the request."
msgstr "aria2: аддалены сервер не змог апрацаваць запыт."

#: uget/UgetPluginAria2.c:309
msgid "aria2: could not parse JSON-RPC request."
msgstr "aria2: не ўдалося парсіраваць запыт JSON-RPC."

#: uget/UgetPluginAria2.c:312
msgid "No response. Is aria2 shutdown?"
msgstr "Няма адказу. Можа, aria2 адключаная?"

#. debug
#: uget/UgetPluginAria2.c:613
msgid "aria2: gid was removed."
msgstr "aria2: gid быў выдалены."

