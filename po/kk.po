#. UGET_EVENT_WARNING_CUSTOM
#: uget/UgetEvent.c:73 uget/UgetPluginAria2.c:292
msgid "Output file can't be renamed."
msgstr "Шығару файлын қайта атауға болмайды."

#. UGET_EVENT_ERROR_CUSTOM
#: uget/UgetEvent.c:81
msgid "couldn't connect to host."
msgstr "Хостқа қосыла алмады."

#. UGET_EVENT_ERROR_CONNECT_FAILED
#: uget/UgetEvent.c:82 uget/UgetPluginAria2.c:296
msgid "Folder can't be created."
msgstr "Папканы жасау мүмкін емес."

#. UGET_EVENT_ERROR_FOLDER_CREATE_FAILED
#: uget/UgetEvent.c:83
msgid "File can't be created (bad filename or file exist)."
msgstr "Файлды жасау мүмкін емес (файл атауы дұрыс емес немесе файл бар)."

#. UGET_EVENT_ERROR_FILE_CREATE_FAILED
#: uget/UgetEvent.c:84
msgid "File can't be opened."
msgstr "Файлды ашу мүмкін емес."

#. UGET_EVENT_ERROR_FILE_OPEN_FAILED
#: uget/UgetEvent.c:85
msgid "Unable to create thread."
msgstr "Желіні құру мүмкін емес."

#. UGET_EVENT_ERROR_THREAD_CREATE_FAILED,
#: uget/UgetEvent.c:86
msgid "Incorrect source (different file size)."
msgstr "Дұрыс емес көз (файл өлшемі сәйкес келмейді)."

#. UGET_EVENT_ERROR_INCORRECT_SOURCE,
#: uget/UgetEvent.c:87
msgid "Out of resource (disk full or run out of memory)."
msgstr "Ресурс таусылды (диск толы немесе жады таусылды)."

#. UGET_EVENT_ERROR_OUT_OF_RESOURCE
#: uget/UgetEvent.c:88
msgid "No output file."
msgstr "Шығыс файлы жоқ."

#. UGET_EVENT_ERROR_NO_OUTPUT_FILE
#: uget/UgetEvent.c:89
msgid "No output setting."
msgstr "Шығару параметрлері жоқ."

#. UGET_EVENT_ERROR_NO_OUTPUT_SETTING
#: uget/UgetEvent.c:90
msgid "Too many retries."
msgstr "Қайта тырысулар тым көп."

#. UGET_EVENT_ERROR_TOO_MANY_RETRIES
#: uget/UgetEvent.c:91
msgid "Unsupported scheme (protocol)."
msgstr "Қолдау көрсетілмейтін схема (протокол)."

#. UGET_EVENT_ERROR_UNSUPPORTED_SCHEME
#: uget/UgetEvent.c:92
msgid "Unsupported file."
msgstr "Қолдауы жоқ файл."

#. UGET_EVENT_ERROR_UNSUPPORTED_FILE
#: uget/UgetEvent.c:93
msgid "post file not found."
msgstr "Жіберу файлы табылмады."

#. UGET_EVENT_ERROR_POST_FILE_NOT_FOUND
#: uget/UgetEvent.c:94
msgid "cookie file not found."
msgstr "cookie файлы табылмады."

#. 1 - 10
#: uget/UgetPluginAria2.c:278
msgid "aria2: an unknown error occurred."
msgstr "aria2: белгісіз қате орын алған."

#: uget/UgetPluginAria2.c:279
msgid "aria2: time out occurred."
msgstr "aria2: уақыт аяқталды."

#: uget/UgetPluginAria2.c:280
msgid "aria2: resource was not found."
msgstr "aria2: ресурс табылған жоқ."

#: uget/UgetPluginAria2.c:281
msgid ""
"aria2 saw the specified number of 'resource not found' error. See --max-file-"
"not-found option"
msgstr "aria2 көрсетілген санында «ресурс табылмады» қатесін көрсетті. --max-file-not-found опциясын қараңыз"

#: uget/UgetPluginAria2.c:282
msgid "aria2: speed was too slow."
msgstr "aria2: жылдамдығы тым баяу болды."

#: uget/UgetPluginAria2.c:283
msgid "aria2: network problem occurred."
msgstr "aria2: желілік ақау пайда болды."

#: uget/UgetPluginAria2.c:284
msgid "aria2: unfinished downloads."
msgstr "aria2: аяқталмаған жүктеулер."

#. _("Not Resumable"),
#: uget/UgetPluginAria2.c:286
msgid "Out of resource"
msgstr "Ресурс таусылды"

#. _(),
#: uget/UgetPluginAria2.c:287
msgid "aria2: piece length was different from one in .aria2 control file."
msgstr "aria2: бөлік ұзындығы .aria2 бақылау файлындағы мәнінен өзгеше болды."

#. 11 - 20
#: uget/UgetPluginAria2.c:289
msgid "aria2 was downloading same file."
msgstr "aria2 сол файлды жүктеп жатты."

#: uget/UgetPluginAria2.c:290
msgid "aria2 was downloading same info hash torrent."
msgstr "aria2 бірдей info-хэш торрентін жүктеп жатты."

#: uget/UgetPluginAria2.c:291
msgid "aria2: file already existed. See --allow-overwrite option."
msgstr "aria2: файл бұрыннан бар. --allow-overwrite опциясын қараңыз."

#. _("Output file can't be renamed."),
#: uget/UgetPluginAria2.c:293
msgid "aria2: could not open existing file."
msgstr "aria2: бар файлды ашу мүмкін болмады."

#: uget/UgetPluginAria2.c:294
msgid "aria2: could not create new file or truncate existing file."
msgstr "aria2: жаңа файлды жасай алмады немесе бар файлды қысқарта алмады."

#: uget/UgetPluginAria2.c:295
msgid "aria2: file I/O error occurred."
msgstr "aria2: файлдық I/O қатесі орын алды."

#. UGET_EVENT_ERROR_FOLDER_CREATE_FAILED
#: uget/UgetPluginAria2.c:297
msgid "aria2: name resolution failed."
msgstr "aria2: атауды шешу сәтсіз аяқталды."

#: uget/UgetPluginAria2.c:298
msgid "aria2: could not parse Metalink document."
msgstr "aria2: Metalink құжатын талдай алмады."

#. 21 - 30
#: uget/UgetPluginAria2.c:300
msgid "aria2: FTP command failed."
msgstr "aria2: FTP командасы сәтсіз аяқталды."

#: uget/UgetPluginAria2.c:301
msgid "aria2: HTTP response header was bad or unexpected."
msgstr "aria2: HTTP жауап басылығы дұрыс емес немесе күтпеген болды."

#: uget/UgetPluginAria2.c:302
msgid "Too many redirections."
msgstr "Қайта бағдарлаулар саны тым көп."

#: uget/UgetPluginAria2.c:303
msgid "aria2: HTTP authorization failed."
msgstr "aria2: HTTP авторизациясы сәтсіз аяқталды."

#: uget/UgetPluginAria2.c:304
msgid "aria2: could not parse bencoded file(usually .torrent file)."
msgstr "aria2: bencoded файлды (әдетте .torrent файлы) өңдей алмады."

#: uget/UgetPluginAria2.c:305
msgid "aria2: torrent file was corrupted or missing information."
msgstr "aria2: торрент файлы бүлінген немесе ақпарат жетіспейді."

#: uget/UgetPluginAria2.c:306
msgid "aria2: Magnet URI was bad."
msgstr "aria2: Magnet URI дұрыс емес."

#: uget/UgetPluginAria2.c:307
msgid ""
"aria2: bad/unrecognized option was given or unexpected option argument was "
"given."
msgstr "aria2: дұрыс емес/танылмаған опция берілді немесе күтпеген опция аргументі берілді."

#: uget/UgetPluginAria2.c:308
msgid "aria2: remote server was unable to handle the request."
msgstr "aria2: қашықтағы сервер сұранысты өңдей алмады."

#: uget/UgetPluginAria2.c:309
msgid "aria2: could not parse JSON-RPC request."
msgstr "aria2: JSON-RPC сұранымын өңдей алмады."

#: uget/UgetPluginAria2.c:312
msgid "No response. Is aria2 shutdown?"
msgstr "Жауап жоқ. Aria2 жабылды ма?"

