msgid "All Category"
msgstr "Усі категорії"

#. UGET_EVENT_NORMAL_CUSTOM
#: uget/UgetEvent.c:58
msgid "Connecting..."
msgstr "З’єднання…"

#. UGET_EVENT_NORMAL_CONNECT
#: uget/UgetEvent.c:59
msgid "Transmitting..."
msgstr "Передача…"

