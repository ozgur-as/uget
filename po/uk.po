#: uget/UgetEvent.c:60 ui-gtk/UgtkMenubar-ui.c:199 ui-gtk/UgtkNodeView.c:675
msgid "Retry"
msgstr "Спроби"

#. UGET_EVENT_NORMAL_RETRY,
#: uget/UgetEvent.c:61
msgid "Download completed"
msgstr "Завантаження завершено"

#. UGET_EVENT_NORMAL_COMPLETE,
#: uget/UgetEvent.c:62 ui-gtk/UgtkNodeView.c:456
msgid "Finished"
msgstr "Завершено"

